{
  "mcpServers": {
    "zwcad-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--registry=https://registry.npmmirror.com",
        "-y",
        "zwcad-mcp"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "ZWCAD_MCP_PIP_INDEX": "${ZWCAD_MCP_PIP_INDEX}"
      },
      "timeout": 180000,
      "runtime": {
        "type": "node",
        "version": ">=18"
      }
    }
  }
}
